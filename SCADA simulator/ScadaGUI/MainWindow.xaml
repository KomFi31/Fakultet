<!--
    Glavni prikaz SCADA aplikacije.
    Prikazuje sve definisane tagove i omogucava pristup
    funkcijama za dodavanje i upravljanje tagovima.
-->

<Window x:Class="ScadaGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SCADA Application"
        Height="600"
        Width="950"
        Closing="Window_Closing">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Gornja traka -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="0,0,0,15">

            <Button Content="Add"
                    Width="100"
                    Height="35"
                    Margin="0,0,10,0"
                    Click="AddTag_Click"/>

            <Button Content="Refresh"
                    Width="100"
                    Height="35"
                    Click="Refresh_Click"/>

        </StackPanel>

        <!-- Prikaz svih tagova -->
        <DataGrid x:Name="tagsDataGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single">

            <DataGrid.Columns>

                <DataGridTextColumn Header="Name"
                                    Binding="{Binding Name}"
                                    Width="*"/>

                <DataGridTextColumn Header="Type"
                                    Binding="{Binding Type}"
                                    Width="100"/>

                <DataGridTextColumn Header="Description"
                                    Binding="{Binding Description}"
                                    Width="2*"/>

                <DataGridTextColumn Header="I/O Address"
                                    Binding="{Binding IOAddress}"
                                    Width="130"/>

            </DataGrid.Columns>

        </DataGrid>

    </Grid>
</Window>