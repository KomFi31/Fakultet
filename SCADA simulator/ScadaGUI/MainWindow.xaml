<!--
    Glavni prikaz SCADA aplikacije.
    Prikazuje sve definisane tagove i omogucava pristup
    funkcijama za dodavanje i upravljanje tagovima.
-->

<Window x:Class="ScadaGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SCADA Application"
        Height="600"
        Width="950"
        Closing="Window_Closing">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Gornja traka -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="0,0,0,15">

            <Button Content="Add"
                    Width="100"
                    Height="35"
                    Margin="0,0,10,0"
                    Click="AddTag_Click"/>

            <Button Content="Refresh"
                    Width="100"
                    Height="35"
                    Click="Refresh_Click"/>

            <Button Content="Toggle Scan"
                    Width="110"
                    Height="35"
                    Margin="10,0,0,0"
                    Click="ToggleScan_Click"/>

            <Button Content="Delete"
                    Width="100"
                    Height="35"
                    Margin="10,0,0,0"
                    Click="DeleteTag_Click"/>   

        </StackPanel>

        <!-- Prikaz svih tagova -->
        <DataGrid x:Name="tagsDataGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single">

            <DataGrid.Columns>

                <DataGridTextColumn Header="Name"
                                    Binding="{Binding Name}"
                                    Width="*"/>

                <DataGridTextColumn Header="Type"
                                    Binding="{Binding Type}"
                                    Width="100"/>

                <DataGridTextColumn Header="Description"
                                    Binding="{Binding Description}"
                                    Width="2*"/>

                <DataGridTextColumn Header="I/O Address"
                                    Binding="{Binding IOAddress}"
                                    Width="130"/>

                <DataGridTemplateColumn Header="Current Value"
                        Width="130">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">

                                        <!-- AO i DO za sada nemaju prikaz trenutne vrednosti -->
                                        <Setter Property="Text"
                                Value="-"/>

                                        <Style.Triggers>

                                            <DataTrigger Binding="{Binding Type}"
                                         Value="AI">
                                                <Setter Property="Text"
                                        Value="{Binding CurrentValue}"/>
                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding Type}"
                                         Value="DI">
                                                <Setter Property="Text"
                                        Value="{Binding CurrentValue}"/>
                                            </DataTrigger>

                                        </Style.Triggers>

                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Scan"
                        Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">

                                        <Setter Property="Text"
                                Value="-"/>

                                        <Style.Triggers>

                                            <DataTrigger Binding="{Binding Type}"
                                         Value="AI">
                                                <Setter Property="Text"
                                        Value="{Binding OnScan}"/>
                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding Type}"
                                         Value="DI">
                                                <Setter Property="Text"
                                        Value="{Binding OnScan}"/>
                                            </DataTrigger>

                                        </Style.Triggers>

                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>

        </DataGrid>

    </Grid>
</Window>