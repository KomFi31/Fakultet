<!--
    Prikazuje istoriju izabranog analognog ulaznog taga.
    Grafik sadrzi istorijske vrednosti i alarmne granice,
    uz Min, Max i Average statistiku.
-->

<Window x:Class="ScadaGUI.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Analog Input History"
        Height="550"
        Width="900"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="titleTextBlock"
                   Grid.Row="0"
                   FontSize="22"
                   FontWeight="Bold"
                   Margin="0,0,0,15"/>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,0,0,15">

            <TextBlock Text="Min: "
                       FontWeight="Bold"/>
            <TextBlock x:Name="minTextBlock"
                       Margin="0,0,25,0"/>

            <TextBlock Text="Max: "
                       FontWeight="Bold"/>
            <TextBlock x:Name="maxTextBlock"
                       Margin="0,0,25,0"/>

            <TextBlock Text="Average: "
                       FontWeight="Bold"/>
            <TextBlock x:Name="averageTextBlock"/>

        </StackPanel>

        <Border Grid.Row="2"
                BorderBrush="Gray"
                BorderThickness="1"
                Background="White">

            <Canvas x:Name="historyCanvas"
                    Margin="10"
                    SizeChanged="HistoryCanvas_SizeChanged"/>

        </Border>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">

            <Button Content="Refresh"
                    Width="100"
                    Height="35"
                    Margin="0,0,10,0"
                    Click="Refresh_Click"/>

            <Button Content="Close"
                    Width="100"
                    Height="35"
                    Click="Close_Click"/>

        </StackPanel>

    </Grid>
</Window>