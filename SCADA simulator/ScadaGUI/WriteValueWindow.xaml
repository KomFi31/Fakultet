<!--
    Prozor za unos nove vrednosti izlaznog taga.
    Koristi se za upis vrednosti u AO i DO tagove.
-->

<Window x:Class="ScadaGUI.WriteValueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Write Value"
        Height="240"
        Width="370"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <StackPanel Margin="25">

        <TextBlock x:Name="tagNameTextBlock"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0,0,0,15"/>

        <TextBlock Text="New value"/>

        <TextBox x:Name="valueTextBox"
                 Height="30"
                 Margin="0,5,0,20"/>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button Content="Cancel"
                    Width="90"
                    Height="40"
                    Margin="0,0,10,0"
                    Click="Cancel_Click"/>

            <Button Content="Write"
                    Width="90"
                    Height="40"
                    Click="Write_Click"/>

        </StackPanel>

    </StackPanel>
</Window>